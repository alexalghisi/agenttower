# Required for signed session cookies. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# Optional. When unset, AgentTower uses an embedded PGlite database in .data/
# When set, Drizzle connects to this Postgres (including Supabase).
DATABASE_URL=

# Optional Supabase (Auth + Realtime + RLS-backed Postgres).
# The app is fully usable without these; they enable the hosted path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Stripe. When unset, billing uses a local simulator.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Public site URL used in Stripe redirects and invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
